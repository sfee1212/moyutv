<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Bottom Layer: Native Video Player Container -->
    <FrameLayout
        android:id="@+id/player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <!-- Top Layer: OSD (On-Screen Display) UI -->
    <FrameLayout
        android:id="@+id/osd_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent">

        <!-- Splash Screen / Loading Background -->
        <ImageView
            android:id="@+id/splash_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/splash_bg"
            android:visibility="visible" />

        <!-- Loading Text -->
        <TextView
            android:id="@+id/loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="正在加载数据..."
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:visibility="gone" />

        <!-- Buffering Spinner -->
        <ProgressBar
            android:id="@+id/buffering_spinner"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="#FFFFFF"
            android:visibility="gone" />

        <!-- Bottom Right Loading Indicator -->
        <TextView
            android:id="@+id/tv_loading_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="24dp"
            android:text="正在加载..."
            android:textColor="#BBFFFFFF"
            android:textSize="20sp"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:visibility="gone" />

        <!-- Bottom Right Network Speed Indicator -->
        <TextView
            android:id="@+id/tv_network_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="24dp"
            android:text="0 KB/s"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:visibility="visible" />



        <!-- Channel Info Overlay (e.g. Top Right or Bottom) -->
        <LinearLayout
            android:id="@+id/info_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="32dp"
            android:background="#99000000"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_channel_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_channel_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="28sp" />

        </LinearLayout>

        <!-- Main Channel Menu Overlay -->
        <LinearLayout
            android:id="@+id/menu_overlay"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@drawable/bg_menu_panel"
            android:orientation="horizontal"
            android:visibility="gone"
            android:paddingVertical="16dp"
            android:paddingHorizontal="16dp">

            <!-- Left Navigation (Settings + Categories) -->
            <LinearLayout
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/btn_settings_top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/item_focus_bg"
                    android:gravity="center">
                    
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_preferences"
                        android:tint="@color/color_text_category_selector"
                        android:duplicateParentState="true" />
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="设置"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_category_selector"
                        android:layout_marginStart="6dp"
                        android:duplicateParentState="true" />
                </LinearLayout>

                <com.iptv.tvplayer.ui.CustomRecyclerView
                    android:id="@+id/rv_categories"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:descendantFocusability="afterDescendants" />
            </LinearLayout>

            <!-- Channels List -->
            <com.iptv.tvplayer.ui.CustomRecyclerView
                android:id="@+id/rv_channels"
                android:layout_width="240dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:clipToPadding="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:descendantFocusability="afterDescendants" />

            <LinearLayout
                android:id="@+id/catchup_hint_tab"
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:background="@drawable/item_focus_bg"
                android:focusable="true"
                android:clickable="true"
                android:paddingVertical="16dp"
                android:gravity="center"
                android:visibility="gone"
                android:orientation="vertical">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="节&#10;目&#10;单&#10;》"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>

            <!-- Catchup Panel (Merged into Menu Overlay) -->
            <LinearLayout
                android:id="@+id/catchup_panel"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:layout_marginStart="8dp"
                android:visibility="gone">

                <!-- Days Column -->
                <com.iptv.tvplayer.ui.CustomRecyclerView
                    android:id="@+id/rv_catchup_days"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:paddingVertical="16dp"
                    android:clipToPadding="false"
                    android:focusable="false"
                    android:descendantFocusability="afterDescendants" />

                <!-- Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#33FFFFFF" />

                <!-- Programs Column -->
                <com.iptv.tvplayer.ui.CustomRecyclerView
                    android:id="@+id/rv_catchup_programs"
                    android:layout_width="280dp"
                    android:layout_height="match_parent"
                    android:paddingVertical="16dp"
                    android:clipToPadding="false"
                    android:focusable="false"
                    android:descendantFocusability="afterDescendants" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== OSD 层（底部信息栏 + 右上角信息 + 左侧竖排节目名） ==================== -->
        <FrameLayout
            android:id="@+id/bottom_osd_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <!-- 左侧竖排当前节目名 -->
            <TextView
                android:id="@+id/tv_osd_vertical_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="42dp"
                android:background="@drawable/bg_osd_title_ribbon"
                android:ellipsize="end"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:maxLines="16"
                android:paddingHorizontal="5dp"
                android:paddingVertical="12dp"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="节目名称"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- 右上角：天气摘要 + 频道号 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="28dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_osd_top_weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_osd_top_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_osd_gold_badge"
                        android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                        android:paddingVertical="1dp"
                        android:text="高清"
                        android:textColor="#4A3200"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_osd_top_channel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:letterSpacing="0.02"
                        android:shadowColor="#8800D2FF"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="12"
                        android:text="0001"
                        android:textColor="#EAF7FF"
                        android:textSize="46sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 大时钟（浮在底栏上方的视频画面区域） -->
            <TextView
                android:id="@+id/tv_osd_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="30dp"
                android:layout_marginBottom="156dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.04"
                android:shadowColor="#9900D2FF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="14"
                android:text="00:00:00"
                android:textColor="#F2FDFF"
                android:textSize="38sp"
                android:textStyle="bold" />

            <!-- 底部渐变信息栏 -->
            <FrameLayout
                android:id="@+id/osd_bottom_panel"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_osd_panel">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:paddingStart="30dp"
                    android:paddingTop="22dp"
                    android:paddingEnd="28dp"
                    android:paddingBottom="30dp">

                    <!-- 左区：频道名 / 技参数 / 正在播放 / 接下来 / 描述 / 进度 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/osd_row_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_osd_channel_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:shadowColor="#80000000"
                                android:shadowDx="0"
                                android:shadowDy="1"
                                android:shadowRadius="4"
                                android:text="频道名称"
                                android:textColor="#FFFFFF"
                                android:textSize="24sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_osd_badge_catchup"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_badge"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:paddingVertical="1dp"
                                android:text="回看"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:visibility="gone" />

                            <Space
                                android:layout_width="16dp"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:id="@+id/tv_osd_tech_specs"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="线路 1/1 · 1920x1080 · 立体声 · IPV4 | 剩余播放: --"
                                android:textColor="#B9E9F7"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/osd_row_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_osd_epg_current"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="正在播放: --"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_osd_epg_next"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="接下来: --"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_osd_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="暂无描述信息"
                            android:textColor="#A9D8E8"
                            android:textSize="12sp" />

                        <ProgressBar
                            android:id="@+id/pb_osd_epg"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="220dp"
                            android:layout_height="3dp"
                            android:layout_marginTop="8dp"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/osd_progress_bar" />

                        <!-- 兼容旧逻辑的隐藏控件（新版界面不展示） -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tv_osd_badge_res"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="HD" />

                            <TextView
                                android:id="@+id/tv_osd_badge_audio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AAC" />

                            <TextView
                                android:id="@+id/tv_osd_badge_aspect"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="16:9" />

                            <TextView
                                android:id="@+id/tv_osd_epg_elapsed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+0 分钟" />

                            <TextView
                                android:id="@+id/tv_osd_epg_remaining"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 分钟" />

                            <TextView
                                android:id="@+id/tv_osd_location"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 右区：日期 / 农历 / 天气 -->
                    <LinearLayout
                        android:layout_width="250dp"
                        android:layout_height="match_parent"
                        android:gravity="end"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="24dp">

                        <TextView
                            android:id="@+id/tv_osd_date_week"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:shadowColor="#80000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="4"
                            android:text="1月1日 星期一"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_osd_lunar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="农历 甲子鼠年 正月初一"
                            android:textColor="#D6F4FF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_osd_weather_today"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="end"
                            android:text="--"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_osd_weather_tomorrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="end"
                            android:text="--"
                            android:textColor="#BFE6F3"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 当前播放地址：贴在 OSD 栏最底部，单行滚动显示 -->
                <TextView
                    android:id="@+id/tv_osd_play_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="30dp"
                    android:layout_marginEnd="28dp"
                    android:layout_marginBottom="8dp"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:scrollHorizontally="true"
                    android:text="播放地址: --"
                    android:textColor="#B9E9F7"
                    android:textSize="12sp" />
            </FrameLayout>
        </FrameLayout>

    </FrameLayout>

    <!-- Top Layer: Settings Overlay -->
    <include layout="@layout/layout_settings_minimal" />

</FrameLayout>

